---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ChatWidget from "../../components/ChatWidget.astro";
import TourForm from "../../components/TourForm.astro";
import { facilities } from "../../data/playhouse.js";

const serviceCards = [
  ["Preschool Education", "British EYFS learning experiences for children under five, designed to support social and academic development.", "/gallery/mothers-nursery-school-limbugaon-darjeeling-schools-nw25p7fg88.avif"],
  ["Daycare Services", "Reliable childcare facilities with nurturing routines, trained staff and safe learning environments.", "/gallery/child-s-dream-nursery-dabholi-surat-playgroups-93xvrlmwu2.webp"],
  ["Role Play Centers", "Home corner, market, doctor’s clinic, construction zone and salon play to stimulate imagination.", "/gallery/divine-child-play-group-and-nursery-ghatkopar-west-mumbai-nursery-schools-azeyavsr2p.webp"],
  ["Reading & Literacy Corner", "Story time, phonics resources, puppet storytelling, letter recognition and pre-writing activities.", "/gallery/images.jpeg"],
  ["Arabic & Cultural Learning", "Arabic language programme and cultural exploration that celebrate diversity and global awareness.", "/gallery/57d3d6_e8f201dbfa844a7a866f7a5dc4d8fcc1~mv2.jpg"],
  ["Creative Arts & STEAM", "Music, art, sensory discovery and STEAM-inspired activities that develop confidence and problem-solving.", "/gallery/premium_photo-1663106419176-ab3e42499a5c.avif"]
];
---

<BaseLayout title="Playhouse Nursery Services & Facilities" description="Explore Playhouse Nursery services including preschool, daycare, EYFS learning, role play, Arabic class, literacy and creative arts.">
  <Header />
  <main class="inner-page">
    <section class="page-hero env-hero">
      <div class="container narrow">
        <h1>Our Services</h1>
        <p>Preschool and daycare services managed by caring educators in a safe, nurturing and inclusive setting.</p>
      </div>
    </section>
    <section class="feature-band">
      <div class="container card-grid">
        {serviceCards.map(([title, text, image]) => <article><img src={image} alt={title} loading="lazy" /><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </section>
    <section class="split-section">
      <div class="container split-grid">
        <img src="/gallery/role-of-nursery-school-education.jpg" alt="Playhouse teacher and child drawing" />
        <div>
          <h2>Facilities Designed for Growth</h2>
          <p>Our settings provide a safe, nurturing and inclusive space where every child is valued and supported.</p>
          <ul class="pill-list">{facilities.map((facility) => <li>{facility}</li>)}</ul>
        </div>
      </div>
    </section>
    <TourForm />
  </main>
  <Footer />
  <ChatWidget />
  <script is:inline src="/scripts/main.js"></script>
</BaseLayout>
