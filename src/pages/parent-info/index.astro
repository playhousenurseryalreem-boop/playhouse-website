---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ChatWidget from "../../components/ChatWidget.astro";
import TourForm from "../../components/TourForm.astro";
---

<BaseLayout title="Parent Information | Playhouse Nursery" description="Parent information for Playhouse Nursery families.">
  <Header />
  <main class="inner-page">
    <section class="page-hero parent-hero">
      <div class="container narrow">
        <h1>Parent Information</h1>
        <p>Helpful information for families joining Playhouse Nursery across Abu Dhabi and Dubai.</p>
      </div>
    </section>
    <section class="feature-band">
      <div class="container card-grid">
        <article><img src="/gallery/student-leaf-art.png" alt="Nursery approvals" loading="lazy" /><h3>Approvals</h3><p>Our Dubai branch is KHDA approved and our Abu Dhabi branches are ADEK approved.</p></article>
        <article><img src="/gallery/math-blocks-play.png" alt="Nursery age groups" loading="lazy" /><h3>Ages</h3><p>Dubai welcomes children from 45 days to 5 years. Abu Dhabi welcomes children from 45 days to 4 years.</p></article>
        <article><img src="/gallery/sensory-group-play.png" alt="Parent partnership" loading="lazy" /><h3>Parent Partnership</h3><p>We work together with families to support every child’s progress, wellbeing and confidence.</p></article>
      </div>
    </section>
    <TourForm />
  </main>
  <Footer />
  <ChatWidget />
  <script is:inline src="/scripts/main.js"></script>
</BaseLayout>
