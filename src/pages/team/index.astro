---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ChatWidget from "../../components/ChatWidget.astro";
import { team } from "../../data/playhouse.js";
---

<BaseLayout title="Our Team | Playhouse Nursery" description="Meet the Playhouse Nursery principal, teachers, assistant teachers and support team.">
  <Header />
  <main class="inner-page">
    <section class="page-hero about-hero">
      <div class="container narrow">
        <h1>Our Team</h1>
        <p>Meet the caring educators and support team who make Playhouse Nursery a warm, safe and inspiring place for children.</p>
      </div>
    </section>
    <section class="team-section">
      <div class="container team-grid">
        {team.map((member) => (
          <article class="team-card">
            <div class="team-avatar">{member.name.replace("Ms. ", "").slice(0, 1)}</div>
            <h2>{member.name}</h2>
            <h3>{member.role}</h3>
            <ul>{member.details.map((detail) => <li>{detail}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <ChatWidget />
  <script is:inline src="/scripts/main.js"></script>
</BaseLayout>
