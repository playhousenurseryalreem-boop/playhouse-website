---
import { branches } from "../data/playhouse.js";
import { keywordPages, localAreas } from "../data/seoContent.generated.js";
import { areaLabel, keywordRouteSlug, localRouteSlug } from "../data/seoHelpers.js";
import { brochureDownload } from "../data/policies.js";

const footerLinks = [
  ["About", "/about/"],
  ["Branches", "/location/"],
  ["Contact Us", "/contact-us/"],
  ["Curriculum", "/age-groups/"],
  ["Services", "/services/"],
  ["Admissions", "/admissions/"],
  ["Policies & Guidelines", "/policies/"],
  ["Book a Visit", "/book-a-visit/"]
];

const footerPolicies = [
  ["Admissions Policy", "/policies/admissions-policy/"],
  ["Health & Safety", "/policies/health-and-safety-policy/"],
  ["Safeguarding & Protection", "/policies/safeguarding-child-protection-and-wellbeing-policy/"],
  ["Food Safety & Nutrition", "/policies/food-safety-and-healthy-eating-policy/"],
  ["Infection Control", "/policies/infection-control-policy/"],
  ["Settling-In Policy", "/policies/settling-in-policy/"],
  ["Visitor Policy", "/policies/visitor-policy/"],
  ["Complaints Procedure", "/policies/complaints-procedure/"]
];

const footerDubaiLinks = [
  ...localAreas
    .filter((area) => area.city === "Dubai")
    .slice(0, 6)
    .map((area) => [`Nursery in ${areaLabel(area)}`, `/nursery-in-${localRouteSlug(area)}/`]),
  ...keywordPages
    .filter((page) => {
      const keyword = page.keyword.toLowerCase();
      return keyword.includes("dubai") || keyword.includes("mirdif") || keyword.includes("khda");
    })
    .slice(0, 6)
    .map((page) => [page.keyword, `/${keywordRouteSlug(page, localAreas, keywordPages)}/`])
];

const footerAbuDhabiLinks = [
  ...localAreas
    .filter((area) => area.city === "Abu Dhabi")
    .slice(0, 6)
    .map((area) => [`Nursery in ${areaLabel(area)}`, `/nursery-in-${localRouteSlug(area)}/`]),
  ...keywordPages
    .filter((page) => {
      const keyword = page.keyword.toLowerCase();
      return keyword.includes("abu dhabi") || keyword.includes("khalidiya") || keyword.includes("reem") || keyword.includes("adek");
    })
    .slice(0, 6)
    .map((page) => [page.keyword, `/${keywordRouteSlug(page, localAreas, keywordPages)}/`])
];
---

<footer class="site-footer">
  <div class="container">
    <nav aria-label="Footer navigation">
      <ul>
        {footerLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>

    <!-- Policies & Brochure Download Strip -->
    <div class="footer-policies-bar" aria-label="Nursery Policies and Downloads">
      <div class="footer-brochure-cta">
        <a href={brochureDownload.pdfUrl} class="footer-brochure-btn" target="_blank" rel="noopener noreferrer" download>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Curriculum Brochure (PDF)</span>
        </a>
      </div>
      <div class="footer-policies-links">
        <span class="footer-policies-title">Nursery Policies:</span>
        <ul>
          {footerPolicies.map(([label, href]) => (
            <li><a href={href}>{label}</a></li>
          ))}
          <li class="view-all-policies"><a href="/policies/">All Policies &rarr;</a></li>
        </ul>
      </div>
    </div>

    <nav class="footer-seo-links" aria-label="Popular nursery pages">
      <div>
        <h2>Dubai Nursery Pages</h2>
        <ul>
          {footerDubaiLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Abu Dhabi Nursery Pages</h2>
        <ul>
          {footerAbuDhabiLinks.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
      <a class="footer-seo-links__more" href="/html-sitemap/">View all nursery pages</a>
    </nav>
    <div class="footer-socials" aria-label="Branch Instagram links">
      {branches.map((branch) => (
        <a class="icon-link instagram-link" href={branch.instagram} target="_blank" rel="noopener">
          <span>{branch.label}</span>
          <strong>Visit Instagram</strong>
        </a>
      ))}
    </div>
    <div class="footer-logos">
      <a href="/"><img src="/logo.png" width="180" height="134" alt="Playhouse Nursery logo" /></a>
    </div>
    <p>©2026 Playhouse Nursery. All Rights Reserved</p>
  </div>
</footer>

<style>
  .footer-policies-bar {
    margin: 28px 0 20px;
    padding: 20px 24px;
    background: rgba(0, 0, 0, 0.14);
    border-radius: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    text-align: left;
  }

  .footer-brochure-cta {
    flex: 0 0 auto;
  }

  .footer-brochure-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #ef6c4c;
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .footer-brochure-btn:hover {
    background: #dd5837;
    transform: translateY(-2px);
  }

  .footer-policies-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    flex: 1 1 500px;
  }

  .footer-policies-title {
    font-size: 13px;
    font-weight: 700;
    color: #fff0bd;
    white-space: nowrap;
  }

  .footer-policies-links ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-policies-links li a {
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-policies-links li a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .footer-policies-links li.view-all-policies a {
    color: #fff0bd;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .footer-policies-bar {
      flex-direction: column;
      align-items: stretch;
      padding: 16px;
    }
    .footer-brochure-btn {
      justify-content: center;
      width: 100%;
    }
  }
</style>
